# Buyuk video dosyalari Git LFS ile takip edilir (GitHub 100 MB siniri icin).
videos/*.mp4  filter=lfs diff=lfs merge=lfs -text
videos/*.mov  filter=lfs diff=lfs merge=lfs -text
videos/*.mkv  filter=lfs diff=lfs merge=lfs -text
videos/*.m4v  filter=lfs diff=lfs merge=lfs -text
videos/*.webm filter=lfs diff=lfs merge=lfs -text
output/*.mp4  filter=lfs diff=lfs merge=lfs -text

# Onayli kutuphane videolari LFS'e ALINMAZ: uretim konteynerinde
# lfs.github.com kapali. Dosyalar ~7 MB, duz git nesnesi olarak tutuluyor.
